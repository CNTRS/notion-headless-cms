{
    "name": "notion-headless-cms",
    "private": true,
    "version": "0.2.0",
    "type": "module",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "main": "./dist/notion-headless-cms.js",
    "module": "./dist/notion-headless-cms.js",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "build": "tsc && vite build",
        "test": "vitest",
        "test:unit": "vitest --project unit",
        "test:integration": "vitest --project integration",
        "test:smoke": "vitest --project smoke",
        "lint": "biome check src/",
        "format": "biome format --write src/",
        "check": "biome ci src/",
        "biome": "biome"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@types/node": "22.13.14",
        "dotenv": "^16.6.1",
        "fast-check": "^4.9.0",
        "msw": "^2.15.0",
        "typescript": "^7.0.2",
        "vite": "6.4.3",
        "vitest": "4.1.10"
    },
    "dependencies": {
        "@notionhq/client": "5.23.3",
        "image-size": "^1.2.1"
    }
}
