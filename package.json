{
    "name": "notion-headless-cms",
    "private": true,
    "version": "0.2.0",
    "type": "module",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "main": "./dist/notion-headless-cms.mjs",
    "module": "./dist/notion-headless-cms.mjs",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "build": "tsc && tsdown",
        "test": "vitest",
        "test:unit": "vitest --project unit",
        "test:integration": "vitest --project integration",
        "test:smoke": "vitest --project smoke",
        "lint": "biome check src/",
        "format": "biome format --write src/",
        "check": "biome ci src/",
        "biome": "biome"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@types/node": "22.13.14",
        "dotenv": "18.0.4",
        "fast-check": "4.10.2",
        "msw": "2.15.0",
        "tsdown": "0.23.0",
        "typescript": "^7.0.2",
        "vite": "8.3.1",
        "vitest": "5.0.2"
    },
    "dependencies": {
        "@notionhq/client": "5.26.0",
        "image-size": "2.0.4"
    },
    "types": "./dist/notion-headless-cms.d.mts",
    "exports": {
        ".": "./dist/notion-headless-cms.mjs",
        "./package.json": "./package.json"
    }
}